{
  "anchors": [
    "night chute"
  ],
  "component_id": "night_chute_notes",
  "family": "Filter",
  "files": [
    "Mail/night_tag.eml",
    "Notes/loft_mill_index.csv",
    "Notes/night_chute_card.txt"
  ],
  "id": "B15",
  "instruction": "Name the notes file under the loft mill folder that is tagged for the night chute.",
  "kind": "entity",
  "locator": {
    "field": "basename",
    "key": "tag",
    "left": "Notes/loft_mill_index.csv",
    "left_where": [
      {
        "col": "tag",
        "eq": "night"
      }
    ],
    "op": "select_join",
    "right": "Mail/night_tag.eml"
  }
}
