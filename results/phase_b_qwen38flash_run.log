<tool_call>
<parameter=bash>
<parameter=command>
cd /tmp && cat > gen2.py <<'PY'
import json,collections,urllib.request,html
op=urllib.request.build_opener(urllib.request.ProxyHandler({}))
def get(u):
    try:
        return {"ok":True,"data":json.load(op.open(u,timeout=20))}
    except Exception as e:
        return {"ok":False,"err":str(e)}
L=[]
def unwrap(x,*keys):
    if isinstance(x,dict):
        for k in keys:
            if k in x: return x[k]
        return []
    return x or []
O=get("http://localhost:3007/api/orders"); R=get("http://localhost:3007/api/restaurants")
V=get("http://localhost:3008/api/reservations")
for tag,g in (("orders",O),("restaurants",R),("reservations",V)):
    L.append(f"[{tag}] ok={g['ok']} {g.get('err','')}")
orders=unwrap(O.get('data'),'orders','data','items')
rests=unwrap(R.get('data'),'restaurants','data','items')
resv=unwrap(V.get('data'),'reservations','data','items')
name={str(x.get('id')):x.get('name') for x in rests}
L.append(f"counts orders={len(orders)} rests={len(rests)} resv={len(resv)}")
if orders: L.append("order_fields="+",".join(sorted(orders[0].keys())))
if resv: L.append("resv_fields="+",".join(sorted(resv[0].keys())))
L.append("order_status="+str(dict(collections.Counter(str(x.get('status')) for x in orders))))
L.append("resv_status="+str(dict(collections.Counter(str(x.get('status')) for x in resv))))
oc=[x for x in orders if str(x.get('status')).lower()!='cancelled']
rc=[x for x in resv if str(x.get('status')).lower() not in ('cancelled','canceled')]
cnt=collections.Counter(name.get(str(x.get('restaurant_id')),'id'+str(x.get('restaurant_id'))) for x in oc)
vcnt=collections.Counter(x.get('venue_name') or name.get(str(x.get('restaurant_id')),'?') for x in rc)
L.append("TOPDELIV::"+"; ".join(f"{k}={n}" for n,k in cnt.most_common()))
L.append("TOPRESV::"+"; ".join(f"{k}={n}" for n,k in vcnt.most_common()))
L.append(f"TOTALS delivery_events={len(oc)} places={len(cnt)} | resv_events={sum(vcnt.values())} venues={len(vcnt)}")
open('/tmp/s2.txt','w').write("\n".join(L)+"\n")
open('/tmp/report.html','w').write("<!doctype html><meta charset=utf-8><body style='background:#fff'><h1>REPORT</h1><pre style='font-size:26px;line-height:1.7'>"+html.escape("\n".join(L))+"</pre></body>")
PY
python3 gen2.py >/dev/null 2>&1; ls -l /tmp/report.html /tmp/s2.txt 2>&1 | tail -3
</parameter>
</function>
</tool_call>
