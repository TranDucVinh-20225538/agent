import json,collections,urllib.request,html
def get(u):
    try:
        req=urllib.request.Request(u,headers={'User-Agent':'x'})
        return json.load(urllib.request.urlopen(req,timeout=15))
    except Exception as e:
        return {"__ERR__":str(e)}
o=get("http://localhost:3007/api/orders")
r=get("http://localhost:3007/api/restaurants")
res=get("http://localhost:3008/api/reservations")
def unwrap(x,*keys):
    if isinstance(x,dict):
        for k in keys:
            if k in x: return x[k]
        return []
    return x
orders=unwrap(o,'orders','data','items')
rests=unwrap(r,'restaurants','data','items')
rs=unwrap(res,'reservations','data','items')
name={str(x.get('id')):x.get('name') for x in rests}
lines=[]
lines.append("orders=%d restaurants=%d reservations=%d"%(len(orders),len(rests),len(rs)))
if isinstance(o,dict) and "__ERR__" in o: lines.append("ERR orders "+o["__ERR__"])
if isinstance(r,dict) and "__ERR__" in r: lines.append("ERR rests "+r["__ERR__"])
if isinstance(res,dict) and "__ERR__" in res: lines.append("ERR res "+res["__ERR__"])
if orders: lines.append("order_fields="+",".join(sorted(orders[0].keys())))
if rs: lines.append("res_fields="+",".join(sorted(rs[0].keys())))
lines.append("order_status="+str(collections.Counter(str(x.get('status')) for x in orders)))
lines.append("res_status="+str(collections.Counter(str(x.get('status')) for x in rs)))
oc=[x for x in orders if str(x.get('status')).lower()!='cancelled']
rc=[x for x in rs if str(x.get('status')).lower()!='cancelled']
cnt=collections.Counter(name.get(str(x.get('restaurant_id')), 'id'+str(x.get('restaurant_id'))) for x in oc)
vcnt=collections.Counter(x.get('venue_name') for x in rc)
lines.append("--- TOP DELIVERY ---")
for n,k in cnt.most_common(): lines.append("%2d  %s"%(k,n))
lines.append("--- TOP RESERVATIONS ---")
for n,k in vcnt.most_common(): lines.append("%2d  %s"%(k,n))
lines.append("TOTAL delivery events=%d over %d places"%(len(oc),len(cnt)))
lines.append("TOTAL reservation events=%d over %d places"%(sum(vcnt.values()),len(vcnt)))
open('/tmp/s1.txt','w').write("\n".join(lines)+"\n")
body=html.escape("\n".join(lines))
open('/tmp/report.html','w').write("<!doctype html><meta charset=utf-8><title>report</title><body style='background:#fff;color:#000'><h1>DINE vs DELIVERY</h1><pre style='font-size:24px;line-height:1.6'>"+body+"</pre></body>")
