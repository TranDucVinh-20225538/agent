  "rubrics": [
    {
      "criterion": "The agent accurately lists the monthly recurring auto-charges shown in Gringotts without adding non-monthly or fabricated charges. The live list mixes autopay-enabled payees with other monthly lines (including a monthly credit-card payment line that the app does not flag as autopay) and carries no explicit active/cancelled flag, so listing the monthly recurring set with or without that card line is acceptable provided the agent is consistent.",
      "type": "llm_judge",
      "weight": 0.45
    },
    {
      "criterion": "The agent accurately reports the amount of each listed monthly recurring charge.",
      "type": "llm_judge",
      "weight": 0.3
    },
    {
      "criterion": "The agent computes a combined monthly total that is arithmetically consistent with the charges it listed and clearly identifies Gringotts as the source of truth; because the live list has no active/cancelled flag and the card-autopay line may reasonably be included or excluded, any total matching the agent's stated treatment is correct.",
      "type": "llm_judge",
      "weight": 0.25
    }
  ]
