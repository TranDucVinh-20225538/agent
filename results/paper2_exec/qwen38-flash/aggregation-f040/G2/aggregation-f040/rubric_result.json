  "rubrics": [
    {
      "criterion": "Agent enumerates the recurring Gringotts bill_pay entries as they appear live (each payee with its amount and frequency) and reports a monthly subtotal that is arithmetically consistent with the list it reported. The live list includes a monthly credit-card payment line that the app does not flag as autopay; a total that includes it and a total that excludes it are both acceptable so long as the agent states which rows it counted.",
      "type": "llm_judge",
      "weight": 0.162462
    },
    {
      "criterion": "Agent accounts for the improv class as a recurring cost using the per-session amount and cadence shown in the Gringotts transactions ledger (a bill_pay improv payee is also acceptable if one is listed live), provided the agent says which source it used and does not count improv twice in the same subtotal.",
      "type": "llm_judge",
      "weight": 0.162462
    },
    {
      "criterion": "Agent scans for other recurring charges and reports findings",
      "type": "llm_judge",
      "weight": 0.15
    },
    {
      "criterion": "Agent optionally checks HooliMail for renewal notices covering the recurring subscriptions and any other regular payments; absence of such emails is acceptable since the primary source is Gringotts",
      "type": "llm_judge",
      "weight": 0.15
    },
    {
      "criterion": "Agent reports both monthly and annual combined totals",
      "type": "llm_judge",
      "weight": 0.124924
    },
    {
      "criterion": "Quality: Complete rollup is clear and totaled",
      "type": "llm_judge",
      "weight": 0.124924
    },
    {
      "criterion": "Agent completes a rollup of everything the user pays regularly including subscriptions, improv class, and any other recurring charges with monthly and annual totals",
      "type": "llm_judge",
      "weight": 0.125228
    }
