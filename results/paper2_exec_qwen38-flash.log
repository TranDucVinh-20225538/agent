import json,re,subprocess
from collections import defaultdict,Counter
def fetch(q):
    r=subprocess.run(['curl','-s','-b','jar',f'http://localhost:3001/api/transactions{q}'],capture_output=True,text=True)
    d=json.loads(r.stdout); return d if isinstance(d,list) else next((v for v in d.values() if isinstance(v,list)),[])
seen={}; off=0
for _ in range(40):
    lst=fetch(f'?limit=100&offset={off}')
    if not lst: break
    new=sum(1 for t in lst if t.get('id') not in seen)
    for t in lst: seen[t['id']]=t
    off+=len(lst)
    if new==0: break
tx=list(seen.values())

IMPROV={'scramton improv academy scr','scranton improv workshop'}
RENT={'zelle to arnay singh - rent'}
UTIL={'ppl electric','comcast'}
GYM={'planet fitness membership scr'}
EXTRA=IMPROV|RENT|UTIL|GYM

def norm(desc):
    d=re.sub(r'\[[^\]]*\]','',desc or '')
    d=re.sub(r'\([^)]*\)','',d)
    d=re.sub(r'\s+',' ',d).strip()
    return d.lower()

groups=defaultdict(list)
for t in tx:
    cat=(t.get('category') or '').lower()
    n=norm(t['description'])
    is_sub = cat in ('subscription','subscriptions')
    is_extra = n in EXTRA
    if is_sub or is_extra:
        groups[n].append(t)

def cadence(items):
    ds=sorted(i['date'] for i in items)
    gaps=[(b-a).days for a,b in zip(ds,ds[1:])]
    gaps=[g for g in gaps if g>0]
    med=sorted(gaps)[len(gaps)//2] if gaps else None
    return med,(ds[0],ds[-1])

rows=[]
for name,items in groups.items():
    pays=[abs(i['amount']) for i in items if i['amount']<0]
    if not pays: continue
    med_amt=sorted(pays)[len(pays)//2]
    gap,rng=cadence(items)
    if gap:
        per_year=365.25/gap
    else:
        per_year=None
    bucket=('improv' if name in IMPROV else 'rent' if name in RENT else
            'utility' if name in UTIL else 'gym' if name in GYM else 'subscription')
    m_eq = round(med_amt*per_year/12,2) if per_year else None
    a_eq = round(med_amt*per_year,2) if per_year else None
    rows.append((bucket,name,len(items),round(med_amt,2),gap,m_eq,a_eq,rng))

order={'subscription':0,'improv':1,'gym':2,'utility':3,'rent':4}
rows.sort(key=lambda r:(order[r[0]],-r[5] if r[5] else 0,r[1]))

print("BUCKET | MERCHANT | n | per_charge | gap_days | mo_eq | yr_eq | span")
tot_m=defaultdict(float); tot_a=defaultdict(float)
for b,n,cnt,amt,gap,me,ae,rng in rows:
    print(f"{b:12} | {n[:40]:40} | {cnt:>3} | {amt:>7} | {str(gap):>4} | {str(me):>8} | {str(ae):>9} | {rng[0]}->{rng[1]}")
    if me: tot_m[b]+=me
    if ae: tot_a[b]+=ae
print("\n=== SUBTOTALS ===")
gm=ga=0
for b in ['subscription','improv','gym','utility','rent']:
    print(f"{b:12}: monthly ${round(tot_m[b],2):>10} | annual ${round(tot_a[b],2):>10}")
    gm+=tot_m[b]; ga+=tot_a[b]
print(f"{'GRAND':12}: monthly ${round(gm,2):>10} | annual ${round(ga,2):>10}")
print(f"\nCOUNT of recurring line items: {len(rows)}")
PY
wc -l recurring_report.txt
</parameter>
</function>
</tool_call>
