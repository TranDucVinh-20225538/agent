<tool_call>
<function=bash>
<parameter=command>
cat > /tmp/triage.py << 'PYEOF'
import os, glob, statistics
from datetime import timezone
from email import policy
from email.parser import BytesParser
from email.utils import parsedate_to_datetime, parseaddr

BASE="/home/user/Maildir"

def files(sub):
    out=[]
    for d in ("cur","new"):
        p=os.path.join(BASE,sub,d)
        if os.path.isdir(p):
            out+= [f for f in glob.glob(os.path.join(p,"*")) if os.path.isfile(f)]
    return out

def hdr(msg,name):
    v=msg.get(name)
    if v is None: return None
    s=str(v).strip()
    # decode any RFC2042 encoded words
    try:
        from email.header import decode_header, make_header
        s=str(make_header(decode_header(s)))
    except Exception:
        pass
    return s.strip()

# ---- parse INCOMING (inbox) ----
incoming={}   # msgid -> (sender_email, recv_dt, subject)
recv_by_sender={}
for f in files("cur") + files("new"):
    try:
        with open(f,'rb') as fh: m=BytesParser(policy=policy.default).parse(fh)
    except Exception: continue
    frm=hdr(m,'From'); dt=None
    try: dt=parsedate_to_datetime(hdr(m,'Date'))
    except Exception: dt=None
    mid=(hdr(m,'Message-ID') or '').lower().strip()
    if not mid or not frm: continue
    _,em=parseaddr(frm); em=em.lower()
    subj=hdr(m,'Subject') or ''
    incoming[mid]=(em,dt,subj)
    recv_by_sender.setdefault(em,[]).append(dt)

# ---- parse OUTGOING (Sent) & link replies ----
replies_by_sender={}   # sender_email -> list of latency seconds
sent_no_link=0
for f in files(".Sent"):
    try:
        with open(f,'rb') as fh: m=BytesParser(policy=policy.default).parse(fh)
    except Exception: continue
    dt=None
    try: dt=parsedate_to_datetime(hdr(m,'Date'))
    except Exception: dt=None
    irt=(hdr(m,'In-Reply-To') or '').lower().strip()
    refs=hdr(m,'References') or ''
    parent=irt
    if not parent and refs:
        toks=[t for t in refs.replace('\n',' ').split() if t.startswith('<')]
        if toks: parent=toks[-1].lower().strip()
    if parent and parent in incoming:
        em,rdt,_=incoming[parent]
        if rdt and dt:
            lat=(dt-rdt).total_seconds()
            replies_by_sender.setdefault(em,[]).append(lat)
    else:
        sent_no_link+=1

# ---- aggregate ----
def fmt(sec):
    if sec is None: return "n/a"
    h=sec/3600.0
    if h<1: return f"{int(sec//60)}m"
    if h<24: return f"{h:.1f}h"
    return f"{h/24:.1f}d"

rows=[]
all_senders=set(incoming.values().__iter__().__class__) # placeholder
senders=set(k for k,_ in [(e,None) for e in recv_by_sender]) | set(replies_by_sender)
for em in senders:
    n_recv=len(recv_by_sender.get(em,[]))
    lats=replies_by_sender.get(em,[])
    n_rep=len(lats)
    med=statistics.median(lats) if lats else None
    rows.append((em,n_recv,n_rep,med))

print("="*70)
print(f"Total incoming msgs indexed : {len(incoming)}")
print(f"Distinct incoming senders   : {len(recv_by_sender)}")
print(f"Sent msgs linked to a reply : {sum(len(v) for v in replies_by_sender.values())}")
print(f"Sent msgs w/o matching inbox: {sent_no_link}")
print("="*70)

# Only consider senders with >=2 received AND at least 1 reply for latency ranking
rep_rows=[r for r in rows if r[2]>=1]
rep_rows.sort(key=lambda r:(r[3] if r[3] is not None else 9e9))

print("\n### FASTEST TO REPLY (median response time) — candidates for HIGH priority ###")
print(f"{'SENDER':40} {'recv':>5} {'repl':>5} {'median_reply':>12}")
for em,n_recv,n_rep,med in rep_rows[:20]:
    print(f"{em:40} {n_recv:>5} {n_rep:>5} {fmt(med):>12}")

slow_rows=[r for r in rep_rows if r[3] is not None and r[3]>3600*24]
print("\n### SLOWEST REPLIES (>1 day) — candidates for LOW priority ###")
for em,n_recv,n_rep,med in sorted(slow_rows,key=lambda r:-r[3]):
    print(f"{em:40} {n_recv:>5} {n_rep:>5} {fmt(med):>12}")

# Senders with lots of incoming but ZERO replies => let sit indefinitely
never=[r for r in rows if r[2]==0 and r[1]>=2]
never.sort(key=lambda r:-r[1])
print("\n### RECEIVED OFTEN BUT NEVER REPLIED (>=2 inbox msgs, 0 replies) ###")
for em,n_recv,n_rep,med in never[:20]:
    print(f"{em:40} {n_recv:>5} {n_rep:>5}")
PYEOF
python3 /tmp/triage.py
</parameter>
</function>
</tool_call>
