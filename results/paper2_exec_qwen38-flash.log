<function=bash>
<parameter=command>
cd /tmp/probe
python3 - <<'PY' > agg_report.txt 2>&1
import json,re,urllib.request,http.cookiejar
# reuse cookie jar file via curl instead
import subprocess
def fetch(q):
    r=subprocess.run(['curl','-s','-b','jar',f'http://localhost:3001/api/transactions{q}'],capture_output=True,text=True)
    d=json.loads(r.stdout)
    return d if isinstance(d,list) else next((v for v in d.values() if isinstance(v,list)),[])
seen={}
offset=0
for page in range(40):
    lst=fetch(f'?limit=100&offset={offset}')
    if not lst: break
    new=0
    for t in lst:
        if t.get('id') not in seen:
            seen[t['id']]=t; new+=1
    offset+=len(lst)
    if new==0: break
tx=list(seen.values())
print("TOTAL UNIQUE TRANSACTIONS:",len(tx))
dates=[t['date'] for t in tx if t.get('date')]
print("DATE RANGE:",min(dates),"to",max(dates))

def norm(desc):
    d=re.sub(r'\[[^\]]*\]','',desc or '')      # strip [HD-123] order tags
    d=re.sub(r'\([^)]*\)','',d)                 # strip (Economy),(repl ...)
    d=re.sub(r'\s+',' ',d).strip()
    return d

from collections import defaultdict
g=defaultdict(list)
for t in tx:
    g[norm(t['description'])].append(t)

rows=[]
for name,items in g.items():
    items.sort(key=lambda x:x['date'])
    amts=[abs(i['amount']) for i in items if i['amount']<0]   # payments only
    ds=[i['date'] for i in items]
    cats=set(i['category'] for i in items)
    accts=set(str(i['account_id']) for i in items)
    n=len(items)
    # typical payment amount = mode-ish: most common rounded amount
    from collections import Counter
    c=Counter(round(a,2) for a in amts)
    typ=c.most_common(1)[0][0] if c else None
    rows.append((n,name,typ,min(ds),max(ds),round(sum(amts),2),','.join(sorted(cats)),','.join(sorted(accts))))
rows.sort(reverse=True)
print("\n=== PER-MERCHANT (count | name | typical_pay | first | last | total_paid | cats | accts) ===")
for n,name,typ,f,l,tot,cats,accts in rows:
    print(f"{n:>3} | {name[:42]:42} | {typ} | {f} -> {l} | tot={tot} | {cats} | acct {accts}")
PY
wc -l agg_report.txt
</parameter>
</function>
</tool_call>
