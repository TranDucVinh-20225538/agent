cd /home/user/Downloads && python3 << 'EOF' > /home/user/Downloads/build_log.txt 2>&1
import csv, glob, html
from collections import defaultdict

files = ['gringotts-checking-activity.csv','gringotts-sapphire-preferred-activity.csv']
rows=[]
for f in files:
    for r in csv.DictReader(open(f)):
        r['_acct']=f.replace('gringotts-','').replace('-activity.csv','')
        rows.append(r)

print("COLUMNS", list(rows[0].keys()) if rows else None)
print("NROWS", len(rows))

out=open('/home/user/Downloads/all_activity.html','w')
out.write('<html><head><style>body{font-family:monospace;font-size:15px}table{border-collapse:collapse;margin-bottom:26px}td,th{border:1px solid #888;padding:3px 9px}</style></head><body>')
out.write('<h2>COLUMNS: %s</h2>'%html.escape(str(list(rows[0].keys()))))
for f in files:
    out.write('<h2>%s</h2>'%f)
    sub=[r for r in rows if r['_acct']==f.replace('gringotts-','').replace('-activity.csv','')]
    cols=list(sub[0].keys()) if sub else []
    out.write('<table><tr>'+''.join('<th>%s</th>'%html.escape(c) for c in cols)+'</tr>')
    for r in sub:
        out.write('<tr>'+''.join('<td>%s</td>'%html.escape(str(r[c])) for c in cols)+'</tr>')
    out.write('</table>')
out.write('</body></html>')
out.close()
EOF
echo BUILD_DONE
