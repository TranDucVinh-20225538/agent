<tool_call>
<function=bash>
<parameter=command>
cd /home/user/Downloads && python3 -c "
import csv,glob,html
out=open('/home/user/Downloads/all_activity.html','w')
out.write('<html><head><style>body{font-family:monospace;font-size:16px}table{border-collapse:collapse;margin-bottom:30px}td,th{border:1px solid #999;padding:4px 10px}</style></head><body>')
for f in sorted(glob.glob('gringotts-*.csv')):
    out.write('<h2>%s</h2>'%f)
    r=list(csv.reader(open(f)))
    out.write('<table>')
    for i,row in enumerate(r):
        tag='th' if i==0 else 'td'
        out.write('<tr>'+''.join('<%s>%s</%s>'%(tag,html.escape(c),tag) for c in row)+'</tr>')
    out.write('</table>')
out.write('</body></html>')
print('done')
"
