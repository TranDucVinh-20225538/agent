cat > /tmp/triage2.py << 'PYEOF'
import os, glob, statistics, html
from email import policy
from email.parser import BytesParser
from email.utils import parsedate_to_datetime, parseaddr
BASE="/home/user/Maildir"
def files(sub):
    out=[]
    for d in ("cur","new"):
        p=os.path.join(BASE,sub,d)
        if os.path.isdir(p): out+=[f for f in glob.glob(os.path.join(p,"*")) if os.path.isfile(f)]
    return out
def hdr(m,n):
    v=m.get(n)
    if v is None: return None
    s=str(v).strip()
    try:
        from email.header import decode_header,make_header
        s=str(make_header(decode_header(s)))
    except Exception: pass
    return s.strip()
incoming={}; recv={}
for f in files("cur")+files("new"):
    try:
        m=BytesParser(policy=policy.default).parse(open(f,'rb'))
    except Exception: continue
    frm=hdr(m,'From'); 
    try: dt=parsedate_to_datetime(hdr(m,'Date'))
    except Exception: dt=None
    mid=(hdr(m,'Message-ID') or '').lower().strip()
    if not mid or not frm: continue
    _,em=parseaddr(frm); em=em.lower()
    incoming[mid]=(em,dt,hdr(m,'Subject') or '')
    recv.setdefault(em,[]).append(dt)
repl={}; nolink=0
for f in files(".Sent"):
    try: m=BytesParser(policy=policy.default).parse(open(f,'rb'))
    except Exception: continue
    try: dt=parsedate_to_datetime(hdr(m,'Date'))
    except Exception: dt=None
    irt=(hdr(m,'In-Reply-To') or '').lower().strip()
    refs=hdr(m,'References') or ''
    parent=irt
    if not parent and refs:
        t=[x for x in refs.replace('\n',' ').split() if x.startswith('<')]
        if t: parent=t[-1].lower().strip()
    if parent and parent in incoming:
        em,rdt,_=incoming[parent]
        if rdt and dt: repl.setdefault(em,[]).append((dt-rdt).total_seconds())
    else: nolink+=1
def fmt(s):
    if s is None: return "n/a"
    h=s/3600.0
    if h<1: return f"{int(s//60)}m"
    if h<24: return f"{h:.1f}h"
    return f"{h/24:.1f}d"
senders=set(recv)|set(repl)
rows=[]
for em in senders:
    lats=repl.get(em,[])
    rows.append((em,len(recv.get(em,[])),len(lats),(statistics.median(lats) if lats else None)))
rep_rows=sorted([r for r in rows if r[2]>=1],key=lambda r:r[3])
slow=[r for r in rep_rows if r[3]>86400]
never=sorted([r for r in rows if r[2]==0 and r[1]>=2],key=lambda r:-r[1])
o=open("/tmp/triage_report.html","w")
o.write("<html><head><meta charset=utf-8><style>body{font-family:sans-serif;margin:30px;background:#1e1e1e;color:#eee}table{border-collapse:collapse;width:100%;margin-bottom:30px}th,td{padding:6px 10px;border-bottom:1px solid #444;text-align:left}th{background:#333}.hi{color:#7CFC90}.lo{color:#ff7b7b}h2{color:#ffd54a}</style></head><body>")
o.write(f"<h1>Inbox auto-triage analysis</h1><p>Indexed {len(incoming)} inbox messages across {len(recv)} senders; linked {sum(len(v) for v in repl.values())} replies ({nolink} sent msgs had no matching inbox original).</p>")
o.write("<h2 class='hi'>HIGH PRIORITY — you reply fastest</h2><table><tr><th>Sender</th><th>Inbox msgs</th><th>Replies</th><th>Median reply time</th></tr>")
for em,a,b,c in rep_rows[:18]: o.write(f"<tr><td>{html.escape(em)}</td><td>{a}</td><td>{b}</td><td class='hi'>{fmt(c)}</td></tr>")
o.write("</table><h2 class='lo'>LOW PRIORITY — you let these sit (median &gt; 1 day)</h2><table><tr><th>Sender</th><th>Inbox msgs</th><th>Replies</th><th>Median reply time</th></tr>")
for em,a,b,c in sorted(slow,key=lambda r:-r[3]): o.write(f"<tr><td>{html.escape(em)}</td><td>{a}</td><td>{b}</td><td class='lo'>{fmt(c)}</td></tr>")
o.write("</table><h2>NEVER REPLIED (2+ inbox msgs, 0 replies)</h2><table><tr><th>Sender</th><th>Inbox msgs</th></tr>")
for em,a,b,c in never[:15]: o.write(f"<tr><td>{html.escape(em)}</td><td>{a}</td></tr>")
o.write("</table></body></html>")
o.close()
print("done")
PYEOF
python3 /tmp/triage2.py && ls -l /tmp/triage_report.html
</parameter>
</function>
</tool_call>
