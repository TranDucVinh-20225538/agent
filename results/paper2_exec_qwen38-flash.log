import json,subprocess,re
def fetch(q):
    r=subprocess.run(['curl','-s','-b','mjar',f'http://localhost:3016/api/emails{q}'],capture_output=True,text=True)
    try: d=json.loads(r.stdout)
    except: return None,r.stdout[:200]
    lst=d if isinstance(d,list) else next((v for v in d.values() if isinstance(v,list)),None)
    return lst,d
lst,raw=fetch('?limit=500')
if lst is None:
    print("NO LIST; raw top-level keys:", list(raw.keys()) if isinstance(raw,dict) else str(raw)[:300])
    raise SystemExit
print("TOTAL EMAILS:",len(lst))
ks=set()
for e in lst: ks|=set(e.keys())
print("KEYS:",sorted(ks))
print("SAMPLE:",json.dumps(lst[0])[:400])

def txt(e):
    parts=[]
    for k in ('subject','snippet','preview','body','body_preview','text','from_name','sender','from'):
        v=e.get(k)
        if isinstance(v,str): parts.append(v)
    return " ".join(parts).lower()

kw=['renew','subscription','annual','plan','billing','price increase','your membership','auto-renew','expires','per year','yearly','monthly charge','invoice']
hits=[e for e in lst if any(k in txt(e) for k in kw)]
print("\n=== RENEWAL-RELATED MESSAGES:",len(hits),"===")
for e in hits:
    subj=e.get('subject') or ''
    snd=e.get('from_name') or e.get('sender') or e.get('from') or ''
    dt=e.get('date') or e.get('received_at') or e.get('created_at') or ''
    sn=(e.get('snippet') or e.get('preview') or '')[:180].replace('\n',' ')
    print(f"[{dt}] {snd} :: {subj}\n      {sn}\n")
PY
wc -l mail_report.txt
</parameter>
</function>
