# Disk images and anything extracted from them: 5 GB image, 585 MB of databases.
# Both are re-fetchable, and redistributing the benchmark's data is not ours to do.
vm/
out/mock/
out/cf_sandbox/

# Upstream repo, fetched by scripts/setup_upstream.sh
external/

# Vendored wheels for the qcow2/ext4 readers, reinstalled by the setup script
vendor/
wheels/

# Benchmark task files, re-fetchable from HuggingFace
data/

*.sqlite
*.sqlite-wal
*.sqlite-shm
*.qcow2
__pycache__/
*.pyc
.DS_Store

# Generated by scripts/preflight.py on the run host
host.env.sh

# Secrets — never commit keys (MyPCBench also ignores external/.../.env)
.env
.env.*
!.env.example
